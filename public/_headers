# Understood by Netlify and Cloudflare Pages. The service worker must never be cached, so updates arrive;
# the hashed files can be kept for ever.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
